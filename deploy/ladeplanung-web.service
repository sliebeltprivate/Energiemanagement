[Unit]
Description=Ladeplanung Webapp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/energiemanagement
ExecStart=/opt/energiemanagement/.venv/bin/python app.py --host 0.0.0.0 --port 5055
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
