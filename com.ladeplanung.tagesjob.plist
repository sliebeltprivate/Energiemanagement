<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ladeplanung.tagesjob</string>

    <!-- Startet täglich um 15:00 (nach der Veröffentlichung der Day-Ahead-Preise) -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/sliebelt/Projects/Energiemanagement/.venv/bin/python</string>
        <string>/Users/sliebelt/Projects/Energiemanagement/tagesjob.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/sliebelt/Projects/Energiemanagement</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>15</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/sliebelt/Projects/Energiemanagement/tagesjob.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/sliebelt/Projects/Energiemanagement/tagesjob.log</string>
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
